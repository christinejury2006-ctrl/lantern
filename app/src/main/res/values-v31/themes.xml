<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Cold-start starting window reads android:* attrs before onCreate.
         No android:windowBackground here — that hid the splash on first launch.
         Full Lore artwork is drawn as the first Compose frame, not as the system icon. -->
    <style name="Theme.Lantern.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/lore_launch_top</item>
        <item name="android:windowSplashScreenBackground">@color/lore_launch_top</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_empty</item>
        <item name="postSplashScreenTheme">@style/Theme.Lantern</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
