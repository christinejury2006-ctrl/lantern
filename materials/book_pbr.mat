// The book: leather or cloth, with the middle strip of its cover on the spine.
//
// Compiled by matc, not by the phone. A shader compiled at runtime can fail on a device with
// no way to read the compiler's complaint, and a material that fails to compile takes the
// whole scene with it — which is exactly how the shelf came to stop starting.
material {
    name : book_pbr,
    shadingModel : lit,
    requires : [ uv0 ],
    culling : none,
    flipUV : false,
    parameters : [
        { type : float3, name : baseColor },
        { type : float, name : roughness },
        { type : float, name : metallic },
        { type : float2, name : uvOffset },
        { type : float2, name : uvScale },
        { type : float, name : useArtwork },
        { type : sampler2d, name : spineMap }
    ]
}

fragment {
    void material(inout MaterialInputs material) {
        prepareMaterial(material);
        vec2 uv = materialParams.uvOffset + materialParams.uvScale * getUV0();
        vec4 art = texture(materialParams_spineMap, uv);
        // A book with no cover keeps its binding colour.
        material.baseColor = mix(vec4(materialParams.baseColor, 1.0), art, materialParams.useArtwork);
        material.roughness = materialParams.roughness;
        material.metallic = materialParams.metallic;
    }
}
